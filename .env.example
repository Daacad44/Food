DATABASE_URL=postgresql://USER:PASSWORD@SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@SUPABASE_SESSION_POOLER_HOST:5432/postgres
SESSION_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-unique-password
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-separate-random-secret
# Mobile money (EVC Plus / ZAAD / SAHAL) is recorded by hand for now. When a provider API is connected,
# its merchant credentials go here and its adapter is registered in src/lib/payments.ts.

# ---- WaafiPay (mobile money: EVC Plus, Jeeb, ZAAD, SAHAL, eDahab …) ----
# From your WaafiPay merchant account. Leave empty to record mobile money by hand.
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
# sandbox (testing, https://sandbox.waafipay.com/asm) or production (real money, https://api.waafipay.net/asm)
WAAFI_ENV=sandbox
# Secret WaafiPay returns when you register the webhook URL https://YOUR-DOMAIN/api/v1/webhooks/waafi
WAAFI_WEBHOOK_SECRET=
# Optional: currency (default USD), a different API URL, request timeout in ms (default 120000)
# WAAFI_CURRENCY=USD
# WAAFI_API_URL=
# WAAFI_TIMEOUT_MS=120000
